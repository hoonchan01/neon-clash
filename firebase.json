{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "firestore.rules", ".firebaserc", "README.md", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "headers": [
      { "source": "**/*.@(webp|png|jpg|mp3|ogg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] },
      { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  },
  "firestore": { "rules": "firestore.rules" }
}
